{
  "manifest_version": 3,
  "name": "Google 搜索守护（个人版）",
  "version": "1.0.0",
  "description": "将默认搜索引擎设为 Google，并用默认搜索接口验证登录后的实际搜索请求。",
  "permissions": [
    "search",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.google.com/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Google 搜索守护：查看实际校验结果",
    "default_popup": "popup.html"
  },
  "chrome_settings_overrides": {
    "search_provider": {
      "name": "Google",
      "keyword": "google.com",
      "search_url": "https://www.google.com/search?q={searchTerms}",
      "suggest_url": "https://www.google.com/complete/search?output=chrome&q={searchTerms}",
      "favicon_url": "https://www.google.com/favicon.ico",
      "encoding": "UTF-8",
      "is_default": true
    }
  },
  "key": ""
}
